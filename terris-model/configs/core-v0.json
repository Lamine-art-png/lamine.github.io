{
  "run_name": "terris-core-v0",
  "base_model": "Qwen/Qwen3-8B",
  "train_file": "artifacts/data/terris_core_v0_train.jsonl",
  "output_dir": "artifacts/models/terris-core-v0",
  "seed": 42,
  "max_length": 4096,
  "epochs": 2,
  "learning_rate": 0.0002,
  "warmup_ratio": 0.05,
  "weight_decay": 0.01,
  "gradient_accumulation_steps": 8,
  "per_device_train_batch_size": 1,
  "logging_steps": 5,
  "save_steps": 100,
  "bf16": true,
  "qlora_4bit": true,
  "gradient_checkpointing": true,
  "lora": {
    "r": 32,
    "alpha": 64,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  }
}
